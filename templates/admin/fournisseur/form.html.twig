{% extends 'base.html.twig' %}

{% block title %}{{ titre|trans }}{% endblock %}

{% block body %}
    <h1>{{ titre|trans }}</h1>
    {{ form_start(form, {attr: {'data-turbo': 'false'}}) }}
        {{ form_widget(form) }}
        <button type="submit">{{ 'Save'|trans }}</button>
    {{ form_end(form) }}
    <p><a href="{{ path('fournisseur_index') }}">{{ 'Back to the list'|trans }}</a></p>
{% endblock %}
