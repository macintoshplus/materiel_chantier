<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="container">
        <nav>
            <a href="{{ path('projet_index') }}">{{ 'Projects'|trans }}</a> |
            <a href="{{ path('materiau_index') }}">{{ 'Articles'|trans }}</a> |
            <a href="{{ path('fournisseur_index') }}">{{ 'Suppliers'|trans }}</a> |
            <a href="{{ path('catalogue_import') }}">{{ 'CSV import'|trans }}</a> |
            <a href="{{ path('doublage_mur') }}">{{ 'Wall calculation'|trans }}</a>
        </nav>
        {% for message in app.flashes('success') %}
            <p class="flash">{{ message|trans }}</p>
        {% endfor %}
        {% block body %}{% endblock %}
    </body>
</html>
