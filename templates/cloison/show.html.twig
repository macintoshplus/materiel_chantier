{% extends 'layout/editeur.html.twig' %}

{% set titre = cloison ? cloison.nom : 'New partition'|trans %}
{% block title %}{{ titre }}{% endblock %}

{% block fil %}
    <a href="{{ path('projet_index') }}">{{ 'Projects'|trans }}</a> &rsaquo;
    <a href="{{ path('projet_show', {id: piece.projet.id}) }}">{{ piece.projet.nom }}</a> &rsaquo;
    <a href="{{ path('piece_show', {id: piece.id}) }}">{{ piece.nom }}</a> &rsaquo;
    <span aria-current="page">{{ titre }}</span>
{% endblock %}

{% block centre %}
    <h1>{{ titre }}</h1>
    {% if cloison %}
        <div class="btn-group selecteur-cote" role="group" aria-label="{{ 'Side'|trans }}">
            <a class="btn btn-outline-secondary btn-sm{{ cote.value == 'A' ? ' active' : '' }}" href="{{ path('partition_show', {piece: piece.id, cloison: cloison.id, side: 'A'}) }}">{{ 'Side A'|trans }}</a>
            <a class="btn btn-outline-secondary btn-sm{{ cote.value == 'B' ? ' active' : '' }}" href="{{ path('partition_show', {piece: piece.id, cloison: cloison.id, side: 'B'}) }}">{{ 'Side B'|trans }}</a>
        </div>
        {% include 'apercu/_surface.html.twig' with {apercu: apercu} only %}
        <a class="btn btn-outline-secondary btn-sm" href="{{ path('piece_show', {id: piece.id}) }}">{{ 'Back to the room'|trans }}</a>
    {% else %}
        <p class="text-muted">{{ 'Click two points on the plan to set the start and the end, or enter the values.'|trans }}</p>
        <div data-controller="plan-picker" data-plan-picker-etape-value="0">
            {% include 'apercu/_piece.html.twig' with {apercu: apercuPiece, piece: piece, liens: false} only %}
        </div>
    {% endif %}
{% endblock %}

{% block droite %}
    {% embed 'layout/_groupe.html.twig' with {cle: 'layout', titre: 'Layout'} %}
        {% block contenu %}
            {{ form_row(form.nom) }}
            <div class="grille-champs">
                {{ form_row(form.debutX) }}
                {{ form_row(form.debutY) }}
                {{ form_row(form.finX) }}
                {{ form_row(form.finY) }}
                {{ form_row(form.longueur) }}
                {{ form_row(form.angle) }}
            </div>
            {{ form_row(form.murReference) }}
            {{ form_row(form.decalage) }}
            {{ form_row(form.ancrageDebut) }}
            {{ form_row(form.ancrageFin) }}
        {% endblock %}
    {% endembed %}

    {% embed 'layout/_groupe.html.twig' with {cle: 'partition-openings', titre: 'Openings'} %}
        {% block contenu %}
            {% include 'layout/_messages.html.twig' with {messages: controles} only %}
            {% include 'layout/_collection.html.twig' with {champ: form.ouvertures, ajout: 'Add an opening'} only %}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block apres_formulaire %}
    {% if cloison %}
        <form method="post" action="{{ path('partition_delete', {piece: piece.id, cloison: cloison.id}) }}" data-turbo-confirm="{{ 'Delete this partition? Partitions anchored on it become free.'|trans }}" class="suppression">
            <input type="hidden" name="_token" value="{{ csrf_token('supprimer-cloison' ~ cloison.id) }}">
            <button type="submit" class="btn btn-outline-danger btn-sm">{{ 'Delete partition'|trans }}</button>
        </form>
    {% endif %}
{% endblock %}
