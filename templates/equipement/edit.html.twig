{% extends 'base.html.twig' %}

{% block title %}{{ equipement ? 'Edit equipment'|trans : 'Add equipment'|trans }}{% endblock %}

{% block body %}
    <nav class="fil-ariane" aria-label="{{ 'Breadcrumb'|trans }}">
        <a href="{{ path('projet_index') }}">{{ 'Projects'|trans }}</a> &rsaquo;
        <a href="{{ path('projet_show', {id: piece.projet.id}) }}">{{ piece.projet.nom }}</a> &rsaquo;
        <a href="{{ path('piece_show', {id: piece.id}) }}">{{ piece.nom }}</a> &rsaquo;
        <a href="{{ retour }}">{{ surface.nom }}</a> &rsaquo;
        <span aria-current="page">{{ equipement ? 'Edit equipment'|trans : 'Add equipment'|trans }}</span>
    </nav>

    <h1>{{ equipement ? 'Edit equipment'|trans : 'Add equipment'|trans }} <small class="text-muted">({{ ('equipment_family.' ~ famille.value)|trans }})</small></h1>

    {% include 'apercu/_surface.html.twig' with {apercu: apercu, calcul: null} only %}

    {{ form_start(form, {attr: {novalidate: 'novalidate', 'data-testid': 'equipement-form'}}) }}
        {{ form_widget(form) }}
        <button type="submit" class="btn btn-primary">{{ 'Save'|trans }}</button>
        <a class="btn btn-outline-secondary" href="{{ retour }}">{{ 'Cancel'|trans }}</a>
    {{ form_end(form) }}

    {% if equipement %}
        <form method="post" action="{{ path('equipement_delete', {equipement: equipement.id}) }}" class="mt-3" data-testid="equipement-suppression">
            <input type="hidden" name="_token" value="{{ csrf_token('supprimer-equipement' ~ equipement.id) }}">
            <button type="submit" class="btn btn-outline-danger">{{ 'Delete this equipment'|trans }}</button>
        </form>
    {% endif %}
{% endblock %}
